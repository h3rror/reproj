% generated by copilot! contains bugs!

% 2D heat equation (explicit FD)
clear, clc, close all

% Parameters
L = 1;             % domain size (square [0,L]x[0,L])
nx = 100;          % grid points in x
ny = 100;          % grid points in y
alpha = 1.0;       % thermal diffusivity
tfinal = 0.1;      % final time
output_dt = 0.002; % time between frames

% Grid
dx = L/(nx-1);
dy = L/(ny-1);
x = linspace(0,L,nx);
y = linspace(0,L,ny);
[X,Y] = meshgrid(x,y);

% Stability and time step (CFL)
dt_stable = 0.25 * min(dx^2,dy^2) / alpha; % conservative 2D CFL for explicit
dt = min(0.5*dt_stable, 1e-4);            % choose dt (ensure stability)
nt = ceil(tfinal/dt);
dt = tfinal/nt;                           % adjust dt to hit tfinal exactly

% Initial condition: hot Gaussian in center
u = zeros(ny,nx);
% u = exp(-50*((X-0.5*L).^2 + (Y-0.5*L).^2));
u = (-50*((X-0.5*L).^2 + (Y-0.5*L).^2)) < 1;

% Dirichlet BC function (here kept zero on boundaries)
applyBC = @(U) U; % if nonzero BCs needed, modify boundary values here

% Precompute constants
rx = alpha*dt/dx^2;
ry = alpha*dt/dy^2;

if rx+ry > 0.5
    warning('Scheme may be unstable: rx+ry = %g > 0.5. Decrease dt or refine grid.', rx+ry);
end

% Visualization setup
figure('Color','w');
h = surf(X,Y,u,'EdgeColor','none');
axis([0 L 0 L 0 1]);
view(2); colorbar; colormap hot; title('t = 0.0');
drawnow

t = 0;
t_next_frame = output_dt;

% Time loop (explicit)
for it = 1:nt
    % interior update (vectorized)
    uxx = u(:,[2:end end]) - 2*u + u(:,[1 1:end-1]); % second diff in x (columns)
    uyy = u([2:end end],:) - 2*u + u([1 1:end-1],:); % second diff in y (rows)
    u = u + alpha*dt.*(uxx/dx^2 + uyy/dy^2);

    % enforce Dirichlet BCs (zero)
    u(1,:)   = 0; u(end,:) = 0;
    u(:,1)   = 0; u(:,end) = 0;
    u = applyBC(u);

    t = t + dt;

    % output frame
    if t >= t_next_frame - 1e-12 || it==nt
        set(h,'ZData',u);
        title(sprintf('t = %.4f', t));
        caxis([0 1]);
        drawnow
        t_next_frame = t_next_frame + output_dt;
    end
end